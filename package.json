{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "limusic",
  "title": "Limusic",
  "description": "Control the Limusic desktop YouTube Music client: playback, now playing, search, queue and playlists.",
  "icon": "extension-icon.png",
  "author": "aijec",
  "categories": ["Media"],
  "license": "MIT",
  "platforms": ["Windows", "macOS"],
  "preferences": [
    {
      "name": "token",
      "title": "Access Token",
      "description": "From Limusic: Settings > Data > Local API.",
      "type": "password",
      "required": true
    },
    {
      "name": "port",
      "title": "Port",
      "description": "The Local API port set in Limusic.",
      "type": "textfield",
      "required": false,
      "default": "26538"
    }
  ],
  "commands": [
    { "name": "toggle", "title": "Play / Pause", "description": "Toggle playback.", "mode": "no-view" },
    { "name": "next", "title": "Next Track", "description": "Skip to the next track.", "mode": "no-view" },
    { "name": "previous", "title": "Previous Track", "description": "Go to the previous track.", "mode": "no-view" },
    { "name": "like-current", "title": "Like Current Track", "description": "Like or unlike the playing track.", "mode": "no-view" },
    { "name": "volume-up", "title": "Increase Volume", "description": "Raise the volume by 10.", "mode": "no-view" },
    { "name": "volume-down", "title": "Decrease Volume", "description": "Lower the volume by 10.", "mode": "no-view" },
    { "name": "toggle-shuffle", "title": "Toggle Shuffle", "description": "Turn shuffle on or off.", "mode": "no-view" },
    { "name": "cycle-repeat", "title": "Cycle Repeat", "description": "Off, all, one.", "mode": "no-view" },
    { "name": "now-playing", "title": "Now Playing", "description": "The playing track, with controls.", "mode": "view" },
    { "name": "search", "title": "Search Music", "description": "Search songs, albums, artists and playlists.", "mode": "view" },
    { "name": "queue", "title": "Show Queue", "description": "See and edit the play queue.", "mode": "view" },
    { "name": "playlists", "title": "Library Playlists", "description": "Browse and play your playlists.", "mode": "view" }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.0",
    "@raycast/utils": "^1.19.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit"
  }
}
